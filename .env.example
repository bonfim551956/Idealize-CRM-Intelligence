# ===== Banco =====
# Vazio = banco local embutido (PGlite em ./.data). Em produção: string do Postgres/Supabase (servidor apenas).
DATABASE_URL=

# ===== Sessão =====
# Mínimo 32 caracteres aleatórios
SESSION_SECRET=

# ===== Meta (somente servidor — nunca expor no frontend) =====
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
# Token de sistema (Business Manager > Usuários do sistema) com ads_read; leads_retrieval para Lead Ads
META_SYSTEM_USER_TOKEN=
# Texto livre escolhido por você e repetido no painel do app Meta ao assinar o webhook
META_WEBHOOK_VERIFY_TOKEN=
# Conjunto de dados (dataset/pixel) para Conversions API — envio fica DESLIGADO até aprovação
META_DATASET_ID=
META_CAPI_ENABLED=false

# ===== Vendas (ADM / PDV) =====
# Chave que o ADM/PDV envia no header X-Integration-Key ao postar vendas
SALES_INGEST_KEY=

# ===== Jobs =====
CRON_SECRET=
